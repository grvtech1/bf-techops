aws_region                  = "ap-south-1"
environment                 = "production"
cluster_admin_principal_arn = "arn:aws:iam::123456789012:role/PlatformAdmin"
cluster_public_access_cidrs = ["203.0.113.10/32"]
notification_provider_url   = "https://notification-provider.example.com/v1/invoices"
notification_provider_api_key = "set-through-a-secure-Terraform-variable-channel"
actor_jwks_url                 = "https://identity.example.com/.well-known/jwks.json"
actor_issuer                   = "https://identity.example.com/"
actor_audience                 = "merchant-platform"
portal_oidc_authorization_endpoint = "https://identity.example.com/oauth2/authorize"
portal_oidc_token_endpoint         = "https://identity.example.com/oauth2/token"
portal_oidc_userinfo_endpoint      = "https://identity.example.com/oauth2/userinfo"
portal_oidc_client_id              = "replace-with-oidc-client-id"
portal_oidc_client_secret          = "replace-with-oidc-client-secret"
oncall_email                   = "platform-oncall@example.com"
monthly_budget_usd             = 750
github_oidc_subject            = "repo:grvtech1/merchant-platform:ref:refs/heads/main"
route53_zone_id                = "Z00000000000000000000"
portal_hostname                = "ops.merchant.example.com"
api_hostname                   = "api.merchant.example.com"
