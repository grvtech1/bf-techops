NODE_ENV=development
API_PORT=8080
PORTAL_PORT=3000
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=merchant_platform
MYSQL_USER=merchant_app
MYSQL_PASSWORD=local-only-password
MYSQL_ROOT_PASSWORD=local-root-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false
PLATFORM_API_KEY=local-platform-api-key-change-me
ACTOR_TOKEN_SECRET=local-actor-token-secret-change-me-32-chars
PAYMENT_PROVIDER=sandboxpay
PAYMENT_WEBHOOK_SECRET=local-payment-webhook-secret-change-me-32-chars
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
OUTBOX_POLL_INTERVAL_MS=1000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BASE_DELAY_MS=1000
NOTIFICATION_PROVIDER=log
WORKER_CONCURRENCY=8
WORKER_METRICS_PORT=9091
IDEMPOTENCY_RETENTION_DAYS=7
OUTBOX_RETENTION_DAYS=30
WEBHOOK_RECEIPT_RETENTION_DAYS=400
ALERT_WEBHOOK_TOKEN=local-alert-webhook-token-change-me
RELEASE_VERSION=local
